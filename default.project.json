{
  "name": "RuralGasShackAnomaly",
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "MapEnvironment": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "InteractiveProps": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "SpiritHouse": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "AnomalyProps": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "VehicleWaypoints": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ClockTime": 0,
        "Brightness": 0.3,
        "Ambient": [0.06, 0.09, 0.08],
        "OutdoorAmbient": [0.06, 0.09, 0.08],
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.25,
        "EnvironmentSpecularScale": 0.2
      },
      "RuralAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.42,
          "Offset": 0.15,
          "Color": [0.08, 0.11, 0.1],
          "Decay": [0.05, 0.07, 0.06],
          "Glare": 0,
          "Haze": 2.2
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
